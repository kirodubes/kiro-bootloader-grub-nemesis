# Re-flash the GRUB boot image after a grub upgrade so the on-disk
# image cannot drift from /boot/grub modules (the classic Arch brick).
# Depends = grub keeps this inert on systemd-boot installs.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = grub

[Action]
Description = Kiro: re-running grub-install (keep the system bootable)
Depends = grub
When = PostTransaction
Exec = /usr/bin/kiro-grub-install
