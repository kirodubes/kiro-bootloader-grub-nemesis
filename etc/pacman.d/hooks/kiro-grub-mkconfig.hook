# Regenerate /boot/grub/grub.cfg when grub, ANY kernel, or microcode
# changes, so menu entries and initrd lines stay correct (new kernels
# get an entry; removed ones drop out). This is menu hygiene, not the
# boot-image safety step (see kiro-grub-install.hook).
#
# kiro-grub-is-active makes it a no-op on systemd-boot systems (grub is
# part of archiso so it is always installed -- the guard, not package
# presence, is what keeps this inert).
#
# Kernels are matched by the vmlinuz they all install
# (usr/lib/modules/*/vmlinuz), NOT by package name -- that catches every
# kernel (linux, -lts, -zen, -cachyos, -hardened, -rt, -xanmod, -tkg,
# custom builds, ...) without ever maintaining a list.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Path
Target = usr/lib/modules/*/vmlinuz

[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = grub
Target = amd-ucode
Target = intel-ucode

[Action]
Description = Kiro: regenerating grub.cfg
When = PostTransaction
Exec = /bin/sh -c '/usr/bin/kiro-grub-is-active || exit 0; exec grub-mkconfig -o /boot/grub/grub.cfg'
